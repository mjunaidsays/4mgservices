# ---------------------------------------------------------------------------
# 4M Global Services — environment variables
# Copy to `.env.local` for development, and set the same values in Vercel.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.4mgservices.com"

# --- Email delivery --------------------------------------------------------
# "resend" (default) sends real email. "log" writes submissions to the server
# log instead — useful locally, and a safe fallback if DNS is not ready.
EMAIL_PROVIDER="resend"

# From resend.com. Server-side only; never exposed to the browser.
RESEND_API_KEY=""

# Must use a domain verified in Resend (add its DKIM/SPF records to
# 4mgservices.com), otherwise delivery will fail or land in spam.
EMAIL_FROM="4M Global Services <website@4mgservices.com>"

# Where enquiries are delivered. Defaults to the address in lib/site-config.ts.
EMAIL_TO="mansoor@4mgservices.com"
